# 1. Берём готовый образ с Node.js
FROM node:18

# 2. Создаём рабочую папку внутри контейнера
WORKDIR /app

# 3. Копируем package.json
COPY package*.json ./

# 4. Устанавливаем зависимости
RUN npm install

# 5. Копируем весь проект внутрь контейнера
COPY . .

# 6. Указываем порт
EXPOSE 5000

# 7. Команда запуска сервера
CMD ["npm", "run", "dev"]